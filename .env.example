# Copy to .env and fill LLM_API_KEY. Any OpenAI-compatible LLM endpoint works (provider-agnostic).
# Example below: Alibaba Cloud Model Studio (DashScope) with deepseek-v4-flash.

# base_url must match your account region (keys are NOT interchangeable across regions):
#   International (Singapore): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   China (Beijing):           https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=your-key-here

# Instructor structured-output mode: JSON or TOOLS (function-calling).
# DeepSeek on Model Studio supports function-calling but NOT JSON mode, so use TOOLS for it.
LLM_MODE=TOOLS

# DashScope hybrid-thinking models (Qwen3, DeepSeek) reject forced tool-calls while "thinking".
# Set false for structured extraction with such models (needed for deepseek-v4-flash + TOOLS).
LLM_ENABLE_THINKING=false
